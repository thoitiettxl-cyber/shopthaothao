{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopthaothao-api",
  "main": "workers/api/index.ts",
  "compatibility_date": "2025-12-11",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "DB",
      "id": "32b7599465724ab1bf089fbd7e9f84be"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://shopthaothao.khosihuythao.com"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "824951",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
